# ============================================================
#  Exile Eye Navigator - Umgebungsvariablen
# ============================================================
# WICHTIG: Kopiere diese Datei und benenne die Kopie in ".env" um
# (also OHNE ".example" am Ende). Die echte .env kommt NIE in den
# Chat, NIE auf GitHub - sie bleibt nur lokal auf deinem PC.
#
# Den SECRET_KEY erzeugst du EINMALIG in der CMD mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Den Output kopierst du dann unten hinter "SECRET_KEY=".
# ============================================================

# Flask Session Secret (PFLICHT) - hier deinen generierten Hex-String rein
SECRET_KEY=hier_deinen_generierten_hex_string_einsetzen

# --- GGG / Path of Exile OAuth Zugangsdaten ---
# Client ID deiner App "Exile Eye Navigator" (oeffentlich, kein Geheimnis)
POE_CLIENT_ID=exileeyenavigator
POE_REDIRECT_URI=http://localhost:8000/callback

# Deine bei GGG hinterlegte Kontakt-Mail (fuer den User-Agent).
# Trage hier DEINE echte Mail ein, damit GGG dich erreichen kann!
POE_CONTACT=deine-mail@example.com

# --- Pfad zu Tesseract-OCR auf DEINEM Rechner ---
# Wichtig: bis zur tesseract.exe durchzeigen!
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Realm: poe2 fuer Path of Exile 2 ---
POE_REALM=poe2

# ============================================================
#  HOSTING (nur fuer die Online-Version relevant)
# ============================================================
# Port: Hosting-Anbieter geben den oft vor. Lokal 8000 lassen.
PORT=8000

# Debug: LOKAL auf 1 lassen. In PRODUKTION (gehostet) auf 0 setzen!
# (schaltet Sicherheits-Cookies an + versteckt Fehler-Details)
FLASK_DEBUG=1

# Tesseract-Pfad auf dem SERVER (Linux): meist /usr/bin/tesseract
# Lokal (Windows) den C:\... Pfad oben lassen.
# Auf einem Linux-Server diese Zeile nutzen:
# TESSERACT_PATH=/usr/bin/tesseract

# Beim Hosting: POE_REDIRECT_URI auf deine echte Domain umstellen, z.B.:
# POE_REDIRECT_URI=https://exileeye.deine-domain.de/callback
# (und diese URI MUSS bei GGG im OAuth-Antrag hinterlegt sein!)
